{
  "expo": {
    "name": "Pimp It",
    "slug": "pimp-it-app",
    "scheme": "pimpitapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pimpitstore.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Pimp It"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise l'accès à tes photos pour choisir une image de pin."
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner le QR code de pointage du pop-up.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ta position est vérifiée au moment du pointage, pour confirmer que tu es bien au pop-up."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "405bef25-7808-43af-b84d-669f240d17ce"
      }
    },
    "owner": "hutiloc",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/405bef25-7808-43af-b84d-669f240d17ce"
    }
  }
}
